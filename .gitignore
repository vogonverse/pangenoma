# .gitignore - Pipeline PanForest
# ===============================

# ============================================
# SNAKEMAKE - Outputs y temporales
# ============================================
.snakemake/
logs/
benchmarks/
*.log

# ============================================
# RESULTADOS - Archivos generados
# ============================================
results/
data/interim/
data/final/

# Mantener estructura de directorios
!results/.gitkeep
!data/interim/.gitkeep
!data/final/.gitkeep

# ============================================
# DATOS CRUDOS - Genomas descargados
# ============================================
data/raw/genomes/
data/raw/ncbi_dataset/
data/raw/*.gff
data/raw/*.gbk
data/raw/*.fna
data/raw/*.faa
data/raw/*.fasta
data/raw/*.fa
data/raw/*.fastq
data/raw/*.fastq.gz

# Mantener datos del repo original para salida de Panaroo del paper (gene_presence_absence.csv)
!data/raw/example_*.csv
!data/raw/.gitkeep

# ============================================
# PANAROO - Outputs intermedios grandes
# ============================================
# Si Panaroo genera outputs en data/raw, ignorarlos
data/raw/panaroo_output/
data/raw/gene_data/
data/raw/*.aln
data/raw/*.tree
data/raw/*.nwk
data/raw/*.phy

# ============================================
# PYTHON - Bytecode y cache
# ============================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/
pip-log.txt
pip-delete-this-directory.txt


# ============================================
# R - Temporales y datos
# ============================================
.Rhistory
.RData
.Rproj.user
*.Rproj
.Rapp.history
*_cache/
/cache/

# ============================================
# CONDA 
# ============================================
.conda/
*.tar.bz2
.snakemake/conda/
workflow/envs/.conda/

# ============================================
# GRÁFICOS REGENERABLES
# ============================================
dag.png
rulegraph.png
filegraph.png
*.pdf
*.svg

# Mantener figuras finales
!results/figures/paper_*.png
!results/figures/paper_*.pdf

# ============================================
# BASE DE DATOS 
# ============================================
results/database/*.db
results/database/*.sqlite
results/database/*.sqlite3
*.db-journal

# ============================================
# CSV GRANDES - Matrices de importancia
# ============================================
# results/random_forest/imp.csv
# results/networks/simplified_imp.csv

# ============================================
# IDEs
# ============================================
# VSCode
.vscode/
*.code-workspace

# ============================================
# SISTEMA OPERATIVO
# ============================================
# Linux
.directory
.Trash-*





