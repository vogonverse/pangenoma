rule all:
    input:
        get_all_targets()

# ============================================
# testing rules
# ============================================

if MODE == "full":
    rule only_download:
        """Download genomes only"""
        input:
            "data/raw/genomes/.download_complete"

    rule only_prokka:
        """Run Prokka annotation only"""
        input:
            "results/prokka/gff_files.txt"

    rule only_panaroo:
        """Run pangenome analysis only"""
        input:
            "results/panaroo/gene_presence_absence.csv"

rule only_preprocessing:
    """Run preprocessing only"""
    input:
        "data/interim/collapsed_matrix.csv",
        "data/interim/non_unique_genes.csv",
        "data/interim/non_unique_genomes.csv"

rule only_random_forest:
    """Run Random Forest only"""
    input:
        "results/random_forest/imp.csv",
        "results/random_forest/performance.csv"

rule only_network:
    """Build gene network only"""
    input:
        "results/networks/directed_network.csv"

if not SKIP_PHYLOGENY:
    rule only_phylogeny:
        """Calculate D statistics only"""
        input:
            "results/phylogeny/d_statistics.tsv",
            "results/phylogeny/d_summary.txt"

if GENERATE_CLUSTERS:
    rule only_clusters:
        """Run clustering only"""
        input:
            "results/clusters/.done"

if GENERATE_DATABASE:
    rule only_database:
        """Build database only"""
        input:
            "results/database/network.db"

# ============================================
# utility rules
# ============================================

rule dag:
    """Generate workflow DAG"""
    output:
        "results/reports/dag.png"
    shell:
        """
        mkdir -p results/reports
        snakemake --dag | dot -Tpng > {output}
        """

rule rulegraph:
    """Generate simplified workflow graph"""
    output:
        "results/reports/rulegraph.png"
    shell:
        """
        mkdir -p results/reports
        snakemake --rulegraph | dot -Tpng > {output}
        """

rule clean:
    """Clean intermediate results (keep genomes)"""
    shell:
        """
        echo "🧹 Cleaning intermediate files..."
        rm -rf data/interim/*
        rm -rf results/random_forest/*
        rm -rf results/networks/*
        rm -rf results/phylogeny/*
        rm -rf results/clusters/*
        rm -rf results/database/*
        rm -rf results/reports/*
        rm -rf logs/*
        rm -rf .snakemake/
        echo "✅ Project cleaned (genomes preserved)"
        """

rule clean_all:
    """Clean EVERYTHING including downloaded genomes"""
    shell:
        """
        echo "🧹 Cleaning ENTIRE project..."
        rm -rf data/interim/*
        rm -rf data/processed/*
        rm -rf data/raw/genomes/*
        rm -rf results/*
        rm -rf logs/*
        rm -rf benchmarks/*
        rm -rf .snakemake/
        echo "✅ Project completely cleaned"
        """

rule reset:
    """Reset downloaded genomes only (useful for re-download)"""
    shell:
        """
        echo "🔄 Resetting genome downloads..."
        rm -rf data/raw/genomes/*
        echo "✅ Ready for re-download"
        """

# ============================================
# logss
# ============================================

onstart:
    import sys

    print("=" * 70)
    print("🧬 PanForest Pipeline - INICIANDO ANÁLISIS")
    print("=" * 70)
    print(f"📋 Modo: {MODE.upper()}")

    if MODE == "example":
        print("   (Usando datos del repo original para testing)")
    elif MODE == "full":
        max_genomes = config["download"].get("max_genomes")
        if max_genomes:
            print(f"   (Descarga limitada: máximo {max_genomes} genomas)")
        else:
            print(f"   (Descarga completa: todos los genomas disponibles)")
        print(f"   Organismo: {config['download']['organism']}")
        print(f"   TaxID: {config['download']['taxid']}")
        print(f"   Assembly levels: {', '.join(config['download']['assembly_levels'])}")

    print("")
    print("📁 Datos de entrada:")
    if MODE == "example":
        print(f"   - Matriz: {config['input']['gene_presence_absence']}")
    else:
        print(f"   - Matriz: Se generará con Panaroo")

    if config['input']['phylogeny']:
        print(f"   - Filogenia: {config['input']['phylogeny']}")
    else:
        print(f"   - Filogenia: No disponible (requerida para D statistics)")

    print("")
    print("🔧 Módulos activos:")
    if MODE == "full":
        print(f"   - Download & Annotation: ✅")
        print(f"   - Panaroo (pangenome): ✅")
    print(f"   - Preprocesamiento: ✅")
    print(f"   - Random Forest: ✅ ({config['random_forest']['n_trees']} árboles, depth={config['random_forest']['max_depth']})")
    print(f"   - Network Analysis: ✅ (threshold={config['network']['importance_threshold']})")
    print(f"   - Phylogeny (D stat): {'❌ SKIP' if SKIP_PHYLOGENY else '✅'}")
    print(f"   - Clustering: {'✅ (' + config['clustering']['method'] + ')' if GENERATE_CLUSTERS else '❌'}")
    print(f"   - Database: {'✅' if GENERATE_DATABASE else '❌'}")

    print("=" * 70)
    print("")

onsuccess:
    import os
    import glob

    print("")
    print("=" * 70)
    print("✅ PanForest Pipeline - EJECUCIÓN COMPLETADA CON ÉXITO")
    print("=" * 70)
    print("")
    print("📊 Resultados disponibles en:")

    if MODE == "full":
        print("")
        print("   🧬 Datos descargados y anotados:")
        print("      - Genomas: data/raw/genomes/genomes/")

        # Contar genomas
        gff_files = glob.glob("data/raw/genomes/genomes/*/*.gff")
        if gff_files:
            print(f"      - Total genomas: {len(gff_files)}")

        # Prokka outputs
        if os.path.exists("results/prokka"):
            print("      - Anotaciones Prokka: results/prokka/")

        # Panaroo outputs
        if os.path.exists("results/panaroo/gene_presence_absence.csv"):
            print("      - Pangenoma (Panaroo): results/panaroo/")
            print("      - Matriz de genes: results/panaroo/gene_presence_absence.csv")

    print("")
    print("   📈 Análisis:")
    print("      - Matriz procesada: data/interim/collapsed_matrix.csv")
    print("      - Random Forest: results/random_forest/")
    print("        * Importancias: results/random_forest/imp.csv")
    print("        * Performance: results/random_forest/performance.csv")
    print("      - Redes: results/networks/")
    print("        * Red dirigida: results/networks/directed_network.csv")
    print("        * Cytoscape: results/networks/cytoscape_network.csv")

    if not SKIP_PHYLOGENY and os.path.exists("results/phylogeny/d_statistics.tsv"):
        print("")
        print("   🌳 Análisis filogenético:")
        print("      - Estadístico D: results/phylogeny/d_statistics.tsv")
        if os.path.exists("results/phylogeny/d_summary.txt"):
            print("      - Resumen: results/phylogeny/d_summary.txt")

    if GENERATE_CLUSTERS and os.path.exists("results/clusters/.done"):
        print("")
        print("   🔍 Clustering:")
        print("      - Cluster files: results/clusters/")
        # Count cluster files
        import glob
        cluster_files = glob.glob("results/clusters/cluster_*.csv")
        if cluster_files:
            print(f"      - Total clusters: {len(cluster_files)}")

    if GENERATE_DATABASE and os.path.exists("results/database/network.db"):
        print("")
        print("   💾 Base de datos:")
        print("      - SQLite DB: results/database/network.db")
        print("")
        print("      Consulta con:")
        print("        sqlite3 results/database/network.db")
        print("        > SELECT COUNT(*) FROM edges;")

    print("")
    print("=" * 70)

onerror:
    print("")
    print("=" * 70)
    print("❌ PanForest Pipeline - ERROR EN LA EJECUCIÓN")
    print("=" * 70)
    print("")
    print("🔍 Diagnóstico:")
    print("   1. Revisa los logs en: logs/")
    print("   2. Verifica el último paso ejecutado")
    print("   3. Ejecuta 'snakemake -n' para ver qué reglas faltan")
    print("")
    print("💡 Comandos útiles:")
    print("   - Ver reglas pendientes: snakemake -n")
    print("   - Ver DAG: snakemake --dag | dot -Tpng > dag.png")
    print("   - Limpiar y reintentar: snakemake clean && snakemake --cores 4")
    print("")
    print("=" * 70)